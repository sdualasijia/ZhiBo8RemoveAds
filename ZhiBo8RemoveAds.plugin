#!name=直播吧去广告
#!desc=关闭开屏、信息流、赛程等广告位，移除游戏中心、首页“专家”、“AI乐园”和“游戏”Tab。最低支持 Loon 3.4.0。
#!author=sdualasijia
#!system=iOS
#!loon_version=3.4.0(0)
#!tag=去广告,直播吧

[URL Rewrite]
# 直播吧广告调度接口。
^http:\/\/(47\.111\.8\.123|47\.99\.237\.245):8091\/ reject-dict

# 旧缓存可能在配置更新前请求广告，直接返回空对象，避免开屏广告出现。
^https:\/\/api-access\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk\/get_ads\/ reject-dict
^https:\/\/mi\.gdt\.qq\.com\/server_bidding2 reject-dict
^https:\/\/opehs\.tanx\.com\/japi reject-dict

[Script]
http-response ^https:\/\/a\.qiumibao\.com\/(ios\/config\/|activities\/config\.php|found\/) script-path=https://raw.githubusercontent.com/sdualasijia/ZhiBo8RemoveAds/d20a6dd74d5f625bc9281908a60cba0770da1717/ZhiBo8RemoveAds.js,requires-body=true,timeout=10,tag=直播吧广告配置清理,enable=true

[MITM]
hostname = a.qiumibao.com,api-access.pangolin-sdk-toutiao.com,mi.gdt.qq.com,opehs.tanx.com
